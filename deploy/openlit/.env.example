# Copy to .env.local (untracked) and fill in. Never commit real values.
OPENLIT_DB_PASSWORD=
# Admin account created by harden.py (replaces OpenLIT's seeded user@openlit.io / openlituser)
OPENLIT_ADMIN_EMAIL=
OPENLIT_ADMIN_PASSWORD=
# Retention (hours): traces and logs, metrics
TRACE_RETENTION_HOURS=168
METRIC_RETENTION_HOURS=720
# Bind addresses. Keep on loopback or an internal interface; use TLS and a VPN or SSO in front for remote access.
OPENLIT_UI_BIND=127.0.0.1
OPENLIT_UI_PORT=3300
OPENLIT_OTLP_BIND=127.0.0.1
OPENLIT_OTLP_HTTP_PORT=4318
OPENLIT_OTLP_GRPC_PORT=4317
OPENLIT_PUBLIC_URL=http://localhost:3300
