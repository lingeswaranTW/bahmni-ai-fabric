# --- Service ---
HOST=127.0.0.1           # the Docker image sets 0.0.0.0
PORT=8090
LOG_LEVEL=info
# URL of OpenMRS (used to validate the forwarded session)
OPENMRS_URL=http://openmrs:8080
GATE_PRIVILEGE=Use AI Chatbot
# --- Model: comma-separated provider:model entries, tried in order (docs/PROVIDERS.md).
# Provider keys use the provider's standard variable. Keep real keys out of git.
AI_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=          # gemini: needs `uv sync --extra gemini`
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OPENAI_COMPAT_BASE_URL=http://vllm:8000/v1   # openai-compat: any OpenAI Chat Completions server
# OPENAI_COMPAT_API_KEY=                        # optional
# AI_MAX_RETRIES=2
# AI_HISTORY_MAX_TOKENS=32000   # lower for small local models
# AI_MAX_TOTAL_TOKENS=0         # 0 = no cap
# AI_MAX_TOOL_STEPS=10
# --- Date and time the model is told (docs/PROMPTS.md#placeholders) ---
# TIMEZONE=UTC                      # IANA name, e.g. Asia/Kolkata
# AI_INJECT_DATETIME=true           # add a date line when the prompt has no {{current_datetime}}
# --- System prompt from OpenLIT's Prompt Hub (optional; docs/PROMPTS.md) ---
# PROMPT_HUB_ENABLED=false
# PROMPT_HUB_MODE=append            # append = keep the built-in safety prompt; replace = hub text only
# PROMPT_HUB_URL=http://openlit:3000
# PROMPT_HUB_PROMPT_NAME=
# PROMPT_HUB_PROMPT_VERSION=        # empty = latest published
# OPENLIT_API_KEY=                  # secret: untracked env file only
# --- MCP (config lives in standard-config; only MCP_* variables are visible to it) ---
MCP_CONFIG_PATH=/etc/bahmni_config/ai/mcp-servers.json
MCP_DOCUMENTS_URL=
MCP_DOCUMENTS_TOKEN=
# --- Storage ---
DATABASE_URL=postgresql+asyncpg://bahmni_ai:change-me@bahmni-ai-db:5432/bahmni_ai
HISTORY_TOOL_RESULTS=none
# --- Telemetry (off by default; see docs/OBSERVABILITY.md) ---
TELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://openlit-host:4318
# OTEL_EXPORTER_OTLP_HEADERS=   # secret: untracked env file only
